# Use a limited database role in production. Never commit real credentials.
DATABASE_URL=postgresql://medisoft:replace-with-local-password@localhost:5432/medisoft
APP_ORIGIN=http://localhost:3000
DASHBOARD_DEMO=false
# Development seed only; supply your own credentials when running db:seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Docker Compose values. Use a different database owner for production migrations.
POSTGRES_PASSWORD=
