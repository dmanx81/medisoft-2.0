# Use a limited database role in production. Never commit real credentials.
DATABASE_URL=postgresql://medisoft:replace-with-local-password@localhost:5432/medisoft
APP_ORIGIN=http://localhost:3000
DASHBOARD_DEMO=false
# Development seed only; supply your own credentials when running db:seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Docker Compose values. Use a different database owner for production migrations.
POSTGRES_PASSWORD=

# Production runtime. NODE_ENV=production rejects localhost APP_ORIGIN,
# placeholder database passwords, demo data, and the stub email provider.
# Sessions are opaque database tokens; there is no JWT/session HMAC secret.
# EMAIL_PROVIDER=smtp|disabled is required in production (stub is forbidden).
# EMAIL_PROVIDER=disabled
# SMTP_URL=smtps://username:replace-with-smtp-password@smtp.example:465
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=billing@example.com
# LOG_LEVEL=info
# BACKUP_DIR=/var/backups/medisoft
# BACKUP_FILE=
# CONFIRM_RESTORE=
